{"nodes": [{"id": "adr_001_cskb_alternatives", "label": "CSKB Alternatives Considered", "file_type": "rationale", "source_file": "engineering/adr/001-cskb.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ChromaDB/Qdrant/Weaviate rejected as default (extra service, pluggable via CSKB_STORE=chroma); Postgres+pgvector rejected (heavyweight); Neo4j rejected (overlaps with graphify-out, keep for local code graph); cloud-only rejected (breaks local-first promise); fine-tuning-only rejected (RAG stays current and citable)."}, {"id": "adr_001_cskb_cli", "label": "cs kb CLI", "file_type": "concept", "source_file": "engineering/adr/001-cskb.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Commands: cs kb ingest, cs kb query, cs kb export-dataset, cs kb refresh."}, {"id": "adr_001_cskb_compliance_principles", "label": "CSKB Platform Principles Compliance", "file_type": "concept", "source_file": "engineering/adr/001-cskb.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AI reasons, tools execute; KB exposed as a port (KBSearch capability); plugins return structured data only (KBChunk); all output must normalize (KBContextExcerpt); apps never call plugins directly (only via ContextBuilder)."}, {"id": "adr_001_cskb_context_builder", "label": "ContextBuilder Integration", "file_type": "code", "source_file": "engineering/adr/001-cskb.md", "source_location": "ai_secos_core/ai_gateway/context.py", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "KB retriever opt-in per AI call (request.use_kb: bool) so cost stays predictable; builds FindingContextPayload with kb_excerpts."}, {"id": "adr_001_cskb_cskb_image", "label": "CSKB Sibling Docker Image", "file_type": "rationale", "source_file": "engineering/adr/001-cskb.md", "source_loc