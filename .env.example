# AstraIX Security Analyst - Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit real secrets to git - .env is gitignored.

# Application
APP_NAME="AstraIX Security Analyst"
APP_VERSION="0.1.0"
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database (dev default; use strong credentials in production)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=astraix
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/astraix
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# Security - generate with: openssl rand -hex 32
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# AI/LLM - credentials go here (all gitignored)
# LLM_PROVIDER=auto | nvidia | ollama
LLM_PROVIDER=ollama
NVIDIA_API_KEY=
AI_MODEL=deepseek-ai/deepseek-v4-pro
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=huihui_ai/qwen2.5-abliterate:7b-instruct

# Neo4j knowledge graph - leave NEO4J_AUTH=none only for local dev
NEO4J_URI=bolt://neo4j:7687
NEO4J_AUTH=none
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# VAPT scan engine
VAPT_USE_DOCKER=true
VAPT_DEMO_MODE=false
KALI_IMAGE=astraix-kali:latest
VAPT_USE_REDIS_PROGRESS=true
SCAN_PROGRESS_TTL=3600

# External VAPT platform adapters (backend/app/vapt/adapters)
# raccoon (in Kali image) is enabled by default; all others opt-in.
VAPT_ADAPTER_RACCOON=true
VAPT_ADAPTER_LYRIE=false
VAPT_ADAPTER_XALGORIX=false
VAPT_ADAPTER_DARKMOON=false
VAPT_ADAPTER_PENTAGI=false
VAPT_ADAPTER_REDAMON=false
VAPT_ADAPTER_ZENAI=false
# xalgorix: bring-your-own-LLM gateway (OpenAI/Anthropic-compatible)
XALGORIX_API_KEY=
XALGORIX_LLM=
XALGORIX_API_BASE=
# darkmoon: HTTP mode (deployed stack) or DARKMOON_PATH for CLI mode
DARKMOON_BASE_URL=
DARKMOON_API_KEY=
DARKMOON_PATH=
# pentagi: base URL + either PENTAGI_API_KEY or PENTAGI_USER/PASSWORD
PENTAGI_BASE_URL=
PENTAGI_API_KEY=
PENTAGI_USER=
PENTAGI_PASSWORD=
# redamon: HTTP mode
REDAMON_BASE_URL=
REDAMON_API_KEY=
# zen-ai-pentest: GitHub Actions mode (needs `gh` CLI authenticated)
ZENAI_REPO=

# External scanners (optional - leave empty to disable)
DARK_MOON_URL=http://localhost:8080
DARK_MOON_API_KEY=
PENTAGI_URL=http://localhost:8443
PENTAGI_API_KEY=

# Security Tools
NMAP_PATH=/usr/bin/nmap
NUCLEI_PATH=/usr/local/bin/nuclei
NUCLEI_TEMPLATES=/home/user/nuclei-templates

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/astraix.log

# Monitoring
SENTRY_DSN=
PROMETHEUS_ENABLED=false

# Feature Flags
FEATURE_AI_ANALYSIS=false
FEATURE_PLUGINS=false
FEATURE_REALTIME=true
