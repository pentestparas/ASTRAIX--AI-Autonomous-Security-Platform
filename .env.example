# AstraIX Security Analyst - Environment Variables
# Copy this file to .env and fill in your values

# Application
APP_NAME="AstraIX Security Analyst"
APP_VERSION="0.1.0"
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/astraix
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# AI/ML (placeholder for future AI integration)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Security Tools (placeholder for future integration)
NMAP_PATH=/usr/bin/nmap
NUCLEI_PATH=/usr/local/bin/nuclei
NUCLEI_TEMPLATES=/home/user/nuclei-templates

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/astraix.log

# Monitoring
SENTRY_DSN=
PROMETHEUS_ENABLED=false

# Feature Flags
FEATURE_AI_ANALYSIS=false
FEATURE_PLUGINS=false
FEATURE_REALTIME=true