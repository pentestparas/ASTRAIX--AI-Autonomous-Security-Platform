# Backend Dockerfile
FROM python:3.12-slim AS base

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    wget \
    git \
    ca-certificates \
    gnupg \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libgdk-pixbuf-2.0-0 \
    libffi-dev \
    shared-mime-info \
    && rm -rf /var/lib/apt/lists/*

# Install Docker CLI
RUN mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian bookworm stable" > /etc/apt/sources.list.d/docker.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends docker-ce-cli && \
    rm -rf /var/lib/apt/lists/*

# Set work directory
WORKDIR /app

# Copy and install Python dependencies
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY backend/app ./app
COPY backend/ai_secos_core ./ai_secos_core
COPY backend/alembic.ini .
COPY backend/alembic ./alembic

# Bake plugins into the image as well (no host bind mount) for AV immunity
COPY plugins /app/plugins

# Bake the complete cybersecurity knowledge base (sources + FAISS/TF-IDF index)
# into the image. The image copy lives inside the Docker VM filesystem, so it
# cannot be deleted or quarantined by host-side antivirus, and it survives
# checkout resets. The entrypoint seeds it into the kb-data volume on first boot.
COPY knowledge-base /opt/astraix-kb

# Entrypoint (seeds the persistent knowledge-base volume, then starts uvicorn)
COPY docker/entrypoint.sh /usr/local/bin/astraix-entrypoint.sh
RUN chmod +x /usr/local/bin/astraix-entrypoint.sh

# Change ownership to root (running as root)
RUN chown -R root:root /app

# Create docker group for socket access
RUN groupadd -r dockeraccess && usermod -aG dockeraccess root

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run as root (docker socket mounted from host - root has full access)
ENTRYPOINT ["/usr/local/bin/astraix-entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--timeout-keep-alive", "120", "--limit-concurrency", "64"]